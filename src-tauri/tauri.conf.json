{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velocity Download Manager (dev)",
  "version": "0.1.0",
  "identifier": "dev.velocity.downloadmanager.v2",
  "build": {
    "beforeDevCommand": "pnpm dev:engine && pnpm dev:web",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm native:verify && pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Velocity Download Manager (dev)",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
