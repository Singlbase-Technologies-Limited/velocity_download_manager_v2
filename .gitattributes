# Normalise line endings for everyone, whatever their core.autocrlf setting.
# Sources are stored and checked out with LF so Windows, Linux and macOS
# contributors never see whole-file line-ending changes.
* text=auto eol=lf

# Windows-only scripts keep CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pdf binary
*.sqlite3 binary
