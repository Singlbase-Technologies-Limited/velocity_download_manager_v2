{
  "name": "velocity-download-manager-v2",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "check:prereqs": "node scripts/doctor.mjs",
    "dev": "tauri dev",
    "dev:web": "vite",
    "dev:engine": "cargo build -p velocity-transfer --bin velocity-transfer && cargo build -p velocity-torrent --bin velocity-torrent",
    "build:web": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:focused": "node scripts/test-focused.mjs",
    "test:e2e:layout": "node tests/e2e/layout/layout-e2e.mjs",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "check:fast": "node scripts/check-fast.mjs",
    "check:pr": "node scripts/check-pr.mjs",
    "check:full": "node scripts/check-full.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:guidance": "node scripts/check-guidance.mjs",
    "native:fetch": "node scripts/native/fetch.mjs",
    "native:build": "node scripts/native/build.mjs",
    "native:verify": "node scripts/native/verify.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
