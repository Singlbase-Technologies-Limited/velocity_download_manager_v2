{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/agent-guard.mjs"]
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(gh auth switch*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *:main *)",
      "PowerShell(git push *refs/heads/main*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git reset * --hard*)",
      "PowerShell(gh auth switch*)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(git push * --tags*)",
      "Bash(git push * --delete *)",
      "Bash(git push * v*)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh release *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(git push * --tags*)",
      "PowerShell(git push * --delete *)",
      "PowerShell(git push * v*)"
    ]
  }
}
